{%- assign header_id = 'CatTitle-' | append: section.id -%}
<section class="section{% if section.settings.surface %} section--surface{% endif %}" aria-labelledby="CatTitle-{{ section.id }}">
  <div class="page-width">
    {% render 'section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      text: section.settings.text,
      link_label: section.settings.link_label,
      link_url: routes.collections_url,
      id: header_id
    %}
    <ul class="cat-grid list-unstyled" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign collection = block.settings.collection
          assign title = block.settings.title | default: collection.title | default: 'Collection'
          assign image = block.settings.image | default: collection.featured_image
          assign url = collection.url | default: block.settings.link | default: routes.all_products_collection_url
          assign size = block.settings.size
          assign sizes = '(min-width: 1200px) 25vw, (min-width: 750px) 33vw, 50vw'
          if size == 'large'
            assign sizes = '(min-width: 1200px) 50vw, (min-width: 750px) 66vw, 100vw'
          elsif size == 'wide'
            assign sizes = '(min-width: 1200px) 50vw, (min-width: 750px) 66vw, 100vw'
          endif
        -%}
        <li class="cat-card cat-card--{{ size }} reveal" style="--i: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
          <div class="cat-card__media" aria-hidden="true">
            {%- if image != blank -%}
              {{ image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: sizes, widths: '300, 450, 600, 800, 1000, 1400', alt: '' }}
            {%- else -%}
              {%- assign ph = forloop.index | modulo: 6 | plus: 1 -%}
              {{ 'collection-' | append: ph | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <a href="{{ url }}" class="cat-card__link" style="position:absolute; inset:0; z-index:2; border-radius: inherit;">
            <span class="visually-hidden">{{ title | escape }}</span>
          </a>
          <h3 class="cat-card__title">{{ title | escape }}</h3>
          <div class="cat-card__meta">
            <span class="cat-card__meta-count">
              {%- if collection != blank and collection.products_count > 0 -%}{{ 'collections.product_count' | t: count: collection.products_count }}{%- else -%}{{ 'collections.shop' | t }}{%- endif -%}
            </span>
            <span class="cat-card__arrow">{% render 'icon', name: 'arrow-up-right' %}</span>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Category grid",
  "max_blocks": 16,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by category" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built for every setup." },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "All collections" },
    { "type": "checkbox", "id": "surface", "label": "Use secondary background", "default": false }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "image_picker", "id": "image", "label": "Image override", "info": "Defaults to the collection image." },
        { "type": "url", "id": "link", "label": "Link (if no collection)" },
        {
          "type": "select", "id": "size", "label": "Card size",
          "options": [
            { "value": "standard", "label": "Standard" },
            { "value": "wide", "label": "Wide" },
            { "value": "large", "label": "Large" }
          ],
          "default": "standard"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category grid",
      "blocks": [
        { "type": "category", "settings": { "title": "Gaming PCs", "size": "large" } },
        { "type": "category", "settings": { "title": "Gaming Accessories" } },
        { "type": "category", "settings": { "title": "Keyboards" } },
        { "type": "category", "settings": { "title": "Gaming Mice", "size": "wide" } }
      ]
    }
  ]
}
{% endschema %}
