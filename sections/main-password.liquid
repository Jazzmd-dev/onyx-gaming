<div class="password">
  <div class="hero__bg" aria-hidden="true"></div>
  <div class="hero__aurora" aria-hidden="true"><span></span><span></span><span></span></div>
  <div class="hero__grid" aria-hidden="true"></div>
  <div>
    <span class="wordmark" style="justify-content:center;">{% render 'icon', name: 'logo-mark', class: 'wordmark__mark' %}<span>{{ shop.name }}</span></span>
    <h1 class="h1">{{ section.settings.heading | escape }}</h1>
    {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
    {% render 'newsletter-form', form_id: 'PasswordNewsletter' %}
    <details style="margin-top: 32px;">
      <summary class="link" style="cursor:pointer; list-style: none;">{{ 'password.owner' | t }}</summary>
      {%- form 'storefront_password', class: 'panel', style: 'margin-top: 16px; text-align: left;' -%}
        {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="form-grid">
          <div class="field"><label class="field__label" for="StorePassword">{{ 'password.label' | t }}</label><input class="input" type="password" name="password" id="StorePassword" autocomplete="current-password" required></div>
          <button type="submit" class="btn">{{ 'password.enter' | t }}</button>
        </div>
      {%- endform -%}
    </details>
  </div>
</div>
{% schema %}
{ "name": "Password", "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Something powerful is loading." } ] }
{% endschema %}
