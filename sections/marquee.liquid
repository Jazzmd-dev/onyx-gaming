{%- if section.blocks.size > 0 -%}
<section class="section section--tight" aria-label="{{ section.settings.label | escape }}">
  <div class="marquee" style="--speed: {{ section.settings.speed }}s;">
    <div class="marquee__track">
      {%- for pass in (1..2) -%}
        <ul class="marquee__group list-unstyled" role="list"{% if pass == 2 %} aria-hidden="true"{% endif %}>
          {%- for block in section.blocks -%}
            <li class="marquee__item" {% if pass == 1 %}{{ block.shopify_attributes }}{% endif %}>
              {%- if block.settings.logo != blank -%}
                {%- assign img_alt = block.settings.text | default: block.settings.logo.alt -%}
                {{ block.settings.logo | image_url: height: 64 | image_tag: loading: 'lazy', alt: img_alt}}
              {%- else -%}
                {{ block.settings.text | escape }}
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Scrolling brands",
  "max_blocks": 16,
  "settings": [
    { "type": "text", "id": "label", "label": "Accessible label", "default": "Brands we carry" },
    { "type": "range", "id": "speed", "label": "Loop duration", "min": 15, "max": 90, "step": 5, "unit": "s", "default": 40 }
  ],
  "blocks": [
    { "type": "item", "name": "Item", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Brand" }, { "type": "image_picker", "id": "logo", "label": "Logo" } ] }
  ],
  "presets": [{ "name": "Scrolling brands", "blocks": [ { "type": "item", "settings": { "text": "Gaming" } }, { "type": "item", "settings": { "text": "Performance" } }, { "type": "item", "settings": { "text": "Precision" } }, { "type": "item", "settings": { "text": "Technology" } } ] }]
}
{% endschema %}
