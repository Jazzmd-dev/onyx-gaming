<div class="page-width">
  <div class="page-hero">
    <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h1 class="h1">{{ page.title | default: section.settings.heading | escape }}</h1>
    {%- if page.content != blank -%}<div class="rte" style="max-width: 640px;">{{ page.content }}</div>{%- endif -%}
  </div>
  <div class="contact">
    <div class="contact__info">
      {%- if settings.store_email != blank -%}
        <div class="info-card">{% render 'icon', name: 'mail' %}<div><p class="info-card__title">{{ 'contact.email' | t }}</p><a href="mailto:{{ settings.store_email }}">{{ settings.store_email | escape }}</a></div></div>
      {%- endif -%}
      {%- if settings.store_phone != blank -%}
        <div class="info-card">{% render 'icon', name: 'phone' %}<div><p class="info-card__title">{{ 'contact.phone' | t }}</p><a href="tel:{{ settings.store_phone | remove: ' ' }}">{{ settings.store_phone | escape }}</a></div></div>
      {%- endif -%}
      {%- if settings.store_hours != blank -%}
        <div class="info-card">{% render 'icon', name: 'clock' %}<div><p class="info-card__title">{{ 'contact.hours' | t }}</p><p>{{ settings.store_hours | escape }}</p></div></div>
      {%- endif -%}
      {%- if settings.store_address != blank -%}
        <div class="info-card">{% render 'icon', name: 'pin' %}<div><p class="info-card__title">{{ 'contact.address' | t }}</p><p>{{ settings.store_address | escape | newline_to_br }}</p></div></div>
      {%- endif -%}
      {%- if shop.shipping_policy.body != blank or shop.refund_policy.body != blank -%}
        <div class="info-card">{% render 'icon', name: 'truck' %}<div><p class="info-card__title">{{ 'contact.policies' | t }}</p>
          {%- if shop.shipping_policy.body != blank -%}<p><a href="{{ shop.shipping_policy.url }}">{{ shop.shipping_policy.title }}</a></p>{%- endif -%}
          {%- if shop.refund_policy.body != blank -%}<p><a href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title }}</a></p>{%- endif -%}
        </div></div>
      {%- endif -%}
      {% render 'social-links' %}
    </div>
    <div class="panel">
      {%- form 'contact', id: 'ContactForm' -%}
        {%- if form.posted_successfully? -%}
          <div class="form-message form-message--success" role="status" tabindex="-1" autofocus style="margin-bottom: 20px;">{% render 'icon', name: 'check' %}<span>{{ 'contact.success' | t }}</span></div>
        {%- elsif form.errors -%}
          <div class="form-message form-message--error" role="alert" tabindex="-1" autofocus style="margin-bottom: 20px;">
            <div><strong>{{ 'contact.error' | t }}</strong>{{ form.errors | default_errors }}</div>
          </div>
        {%- endif -%}
        <div class="form-grid form-grid--2">
          <div class="field">
            <label class="field__label" for="ContactForm-name">{{ 'contact.name' | t }}</label>
            <input class="input" id="ContactForm-name" type="text" name="contact[name]" autocomplete="name" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">
          </div>
          <div class="field">
            <label class="field__label" for="ContactForm-email">{{ 'contact.email' | t }} <span aria-hidden="true">*</span></label>
            <input class="input" id="ContactForm-email" type="email" name="contact[email]" autocomplete="email" required aria-required="true" spellcheck="false" autocapitalize="off" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"{% if form.errors contains 'email' %} aria-invalid="true"{% endif %}>
          </div>
          <div class="field">
            <label class="field__label" for="ContactForm-phone">{{ 'contact.phone' | t }}</label>
            <input class="input" id="ContactForm-phone" type="tel" name="contact[phone]" autocomplete="tel" pattern="[0-9\-\+\s\(\)]*" value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}">
          </div>
          <div class="field">
            <label class="field__label" for="ContactForm-order">{{ 'contact.order' | t }}</label>
            <input class="input" id="ContactForm-order" type="text" name="contact[order_number]" value="{{ form.order_number }}">
          </div>
          <div class="field span-2">
            <label class="field__label" for="ContactForm-topic">{{ 'contact.topic' | t }}</label>
            <select class="select" id="ContactForm-topic" name="contact[topic]">
              {%- assign topics = section.settings.topics | split: ',' -%}
              {%- for t in topics -%}<option value="{{ t | strip | escape }}">{{ t | strip | escape }}</option>{%- endfor -%}
            </select>
          </div>
          <div class="field span-2">
            <label class="field__label" for="ContactForm-body">{{ 'contact.message' | t }} <span aria-hidden="true">*</span></label>
            <textarea class="textarea" id="ContactForm-body" name="contact[body]" required aria-required="true">{{ form.body }}</textarea>
          </div>
          <div class="span-2">
            <button type="submit" class="btn">{{ 'contact.send' | t }} {% render 'icon', name: 'arrow' %}</button>
          </div>
        </div>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Support" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact us" },
    { "type": "text", "id": "topics", "label": "Topics (comma separated)", "default": "Order question, Product question, Returns, Other" }
  ]
}
{% endschema %}
