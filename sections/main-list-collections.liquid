<div class="page-width">
  <div class="page-hero">
    <p class="eyebrow">{{ 'collections.eyebrow' | t }}</p>
    <h1 class="h1">{{ section.settings.heading | escape }}</h1>
  </div>
  {%- paginate collections by 24 -%}
    <ul class="cat-grid list-unstyled page-content" role="list">
      {%- for collection in collections -%}
        <li class="cat-card reveal" style="--i: {{ forloop.index0 | modulo: 8 }};">
          <div class="cat-card__media" aria-hidden="true">
            {%- assign image = collection.featured_image -%}
            {%- if image -%}
              {{ image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 1200px) 25vw, (min-width: 750px) 33vw, 50vw', widths: '300, 450, 600, 900', alt: '' }}
            {%- else -%}
              {%- assign ph = forloop.index | modulo: 6 | plus: 1 -%}
              {{ 'collection-' | append: ph | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <a href="{{ collection.url }}" style="position:absolute; inset:0; z-index:2; border-radius: inherit;"><span class="visually-hidden">{{ collection.title | escape }}</span></a>
          <h2 class="cat-card__title">{{ collection.title | escape }}</h2>
          <div class="cat-card__meta">
            <span class="cat-card__meta-count">{{ 'collections.product_count' | t: count: collection.products_count }}</span>
            <span class="cat-card__arrow">{% render 'icon', name: 'arrow-up-right' %}</span>
          </div>
        </li>
      {%- endfor -%}
    </ul>
    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Collections list",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "All collections" }
  ]
}
{% endschema %}
