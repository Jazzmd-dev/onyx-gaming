{%- assign header_id = 'TabsTitle-' | append: section.id -%}
<section class="section{% if section.settings.surface %} section--surface{% endif %}" aria-labelledby="{{ header_id }}">
  <div class="page-width">
    <onyx-tabs>
      <div class="section-header reveal">
        <div class="section-header__text">
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
          <h2 class="h2" id="{{ header_id }}">{{ section.settings.heading | escape }}</h2>
          {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
        </div>
        {%- if section.blocks.size > 1 -%}
          <div class="tabs" role="tablist" aria-label="{{ section.settings.heading | escape }}">
            {%- for block in section.blocks -%}
              <button
                type="button"
                class="tab"
                role="tab"
                id="Tab-{{ block.id }}"
                aria-controls="Panel-{{ block.id }}"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
                {{ block.shopify_attributes }}
              >
                {{- block.settings.label | default: block.settings.collection.title | escape -}}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        {%- assign collection = block.settings.collection -%}
        <div
          class="tab-panel"
          id="Panel-{{ block.id }}"
          {% if section.blocks.size > 1 %}role="tabpanel" aria-labelledby="Tab-{{ block.id }}"{% endif %}
          {% unless forloop.first %}hidden{% endunless %}
        >
          {%- if collection != blank and collection.products_count > 0 -%}
            <ul
              class="grid list-unstyled{% if section.settings.mobile_scroll %} grid--scroll-mobile{% endif %}"
              role="list"
              style="--cols-mobile: 2; --cols-tablet: {{ section.settings.columns | at_most: 3 }}; --cols-desktop: {{ section.settings.columns }};"
            >
              {%- for product in collection.products limit: section.settings.limit -%}
                <li>{% render 'product-card', product: product, index: forloop.index0 %}</li>
              {%- endfor -%}
            </ul>
          {%- else -%}
            <ul class="grid list-unstyled" role="list" style="--cols-mobile: 2; --cols-tablet: 3; --cols-desktop: {{ section.settings.columns }};">
              {%- for i in (1..section.settings.columns) -%}
                <li>
                  <div class="card">
                    <div class="card__media" style="--card-ratio: {{ settings.card_image_ratio }};">{{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}</div>
                    <div class="card__info">
                      <h3 class="card__title">{{ 'onboarding.product_title' | t }}</h3>
                      <div class="price"><span class="price__current">{{ 4999 | money }}</span></div>
                    </div>
                  </div>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
          {%- if collection != blank -%}
            <div class="center" style="margin-top: 40px;">
              {%- assign tab_title = block.settings.label | default: collection.title -%}
              <a href="{{ collection.url }}" class="btn btn--secondary">{{ 'collections.view_all_in' | t: title: tab_title }} {% render 'icon', name: 'arrow' %}</a>
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </onyx-tabs>
  </div>
</section>

{% schema %}
{
  "name": "Product tabs",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Trending now" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "THE GEAR EVERYONE WANTS." },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "range", "id": "limit", "label": "Products per tab", "min": 2, "max": 16, "step": 1, "default": 8 },
    { "type": "range", "id": "columns", "label": "Desktop columns", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "mobile_scroll", "label": "Swipe on mobile", "default": false },
    { "type": "checkbox", "id": "surface", "label": "Use secondary background", "default": false }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Tab label", "default": "Trending" },
        { "type": "collection", "id": "collection", "label": "Collection" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product tabs",
      "blocks": [
        { "type": "tab", "settings": { "label": "Trending" } },
        { "type": "tab", "settings": { "label": "Bestsellers" } },
        { "type": "tab", "settings": { "label": "New arrivals" } },
        { "type": "tab", "settings": { "label": "Limited offers" } }
      ]
    }
  ]
}
{% endschema %}
