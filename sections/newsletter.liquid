{%- assign form_id = 'Newsletter-' | append: section.id -%}
<section class="section{% if section.settings.tight %} section--tight{% endif %}" id="newsletter-{{ section.id }}">
  <div class="page-width">
    <div class="newsletter reveal">
      <div class="newsletter__copy">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow" style="justify-content:center;">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="h2">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
      </div>
      {% render 'newsletter-form', form_id: form_id, button_label: section.settings.button_label %}
      {%- if section.settings.note != blank -%}<p class="newsletter__note">{{ section.settings.note | escape }}</p>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "paragraph", "content": "Subscribers are added to your Shopify customers list with accepted marketing." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Join the inner circle" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Drops, deals & new tech — first." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Subscribe for product launches, restocks and exclusive offers.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
    { "type": "text", "id": "note", "label": "Small print", "default": "No spam. Unsubscribe anytime." },
    { "type": "checkbox", "id": "tight", "label": "Reduce spacing", "default": false }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
