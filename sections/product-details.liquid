<section class="section section--flush-top" id="details" aria-labelledby="DetailsTitle-{{ section.id }}">
  <div class="page-width">
    <div class="product-details">
      <div class="reveal">
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        <h2 class="h2" id="DetailsTitle-{{ section.id }}" style="margin: 14px 0 28px;">{{ section.settings.heading | escape }}</h2>
        <div class="rte">
          {%- if product.description != blank -%}{{ product.description }}{%- else -%}<p>{{ 'products.product.no_description' | t }}</p>{%- endif -%}
        </div>
      </div>
      {%- if section.settings.show_specs -%}
        <div class="reveal" style="--i: 1;">
          <div class="panel">
            <h3 class="h4" style="margin-bottom: 12px;">{{ section.settings.specs_heading | escape }}</h3>
            {% render 'product-specs', product: product, variant: product.selected_or_first_available_variant %}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product details",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "In detail" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Product details" },
    { "type": "checkbox", "id": "show_specs", "label": "Show specifications", "info": "Add a product metafield custom.specifications (multi-line text, one \"Label: Value\" per line).", "default": true },
    { "type": "text", "id": "specs_heading", "label": "Specifications heading", "default": "Specifications" }
  ],
  "presets": [{ "name": "Product details" }],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
