<div class="page-width">
  <div class="page-hero">
    <p class="eyebrow">{{ 'wishlist.eyebrow' | t }}</p>
    <h1 class="h1">{{ page.title | default: section.settings.heading | escape }}</h1>
    <p>{{ 'wishlist.note' | t }}</p>
  </div>
  <onyx-wishlist-page class="page-content" style="display: block;">
    <div class="grid" data-wishlist-grid style="--cols-mobile: 2; --cols-tablet: 3; --cols-desktop: 4;"></div>
    <div class="wishlist-empty" data-wishlist-empty hidden>
      <p class="h3">{{ 'wishlist.empty' | t }}</p>
      <p>{{ 'wishlist.empty_text' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn">{{ 'collections.shop_all' | t }}</a>
    </div>
    <noscript><p>{{ 'wishlist.no_js' | t }}</p></noscript>
  </onyx-wishlist-page>
</div>
{% schema %}
{ "name": "Wishlist", "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Your wishlist" } ] }
{% endschema %}
